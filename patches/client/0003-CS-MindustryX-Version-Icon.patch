+++ b/build.gradle
@@ -4,12 +4,10 @@ buildscript{
     def arcHash = "v${upstreamBuild}"
     rootProject.ext.upstreamBuild = upstreamBuild
     ext{
-        localArc = new File(rootDir.parent, 'Arc').exists() && !project.hasProperty("noLocalArc")
-
         arcModule = { String name ->
             //skip to last submodule
             name = name.substring(name.lastIndexOf(':') + 1)
-            return "com.github.Anuken${localArc ? "" : ".Arc"}:$name:$arcHash"
+            return "com.github.TinyLake.MindustryX:$name:$arcHash"
         }
     }
 }
@@ -23,7 +21,7 @@ allprojects{
     apply plugin: 'maven-publish'
 
     version = project.hasProperty("packageVersion") ? project.getProperty("packageVersion") : 'release'
-    group = 'com.github.Anuken'
+    group = 'com.github.TinyLake.MindustryX'
 
     ext{
         upstreamBuild = rootProject.ext.upstreamBuild
