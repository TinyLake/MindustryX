From 0133fe895924d21a32c59848fe7d02a0e0e6b5df Mon Sep 17 00:00:00 2001
From: clockworkparrot <a.playful.parrot@qq.com>
Date: Wed, 12 Aug 2026 22:30:30 +0800
Subject: [PATCH] feat: add settings to hide boss health bar and logic markers
 + Chinese translation

---
 core/assets/bundles/bundle_zh_CN.properties   |  2 ++
 core/src/mindustry/core/Renderer.java         | 29 ++++++++++---------
 .../ui/dialogs/SettingsMenuDialog.java        |  2 ++
 .../mindustry/ui/fragments/HudFragment.java   |  2 +-
 4 files changed, 20 insertions(+), 15 deletions(-)

diff --git a/core/assets/bundles/bundle_zh_CN.properties b/core/assets/bundles/bundle_zh_CN.properties
index 9f5517ac0d..b6635973c1 100644
--- a/core/assets/bundles/bundle_zh_CN.properties
+++ b/core/assets/bundles/bundle_zh_CN.properties
@@ -3036,3 +3036,5 @@ lenum.dragmultiplier = 环境阻力乘数
 lenum.ban = 禁用指定内容
 lenum.unban = 解禁指定内容
 lenum.musicvolume = 全局音乐音量倍率。\n取值范围限制在[0,1]。
+setting.showBossHealthBar.name=显示Boss血条
+setting.showLogicMarkers.name=显示逻辑标记
diff --git a/core/src/mindustry/core/Renderer.java b/core/src/mindustry/core/Renderer.java
index 389684d7bb..61590e7273 100644
--- a/core/src/mindustry/core/Renderer.java
+++ b/core/src/mindustry/core/Renderer.java
@@ -385,20 +385,21 @@ public class Renderer implements ApplicationListener{
         float scaleFactor = 4f / renderer.getDisplayScale();
 
         //draw objective markers
-        state.rules.objectives.eachRunning(obj -> {
-            for(var marker : obj.markers){
-                if(marker.world){
-                    marker.draw(marker.autoscale ? scaleFactor : 1);
-                }
-            }
-        });
-
-        for(var marker : state.markers){
-            if(marker.world){
-                marker.draw(marker.autoscale ? scaleFactor : 1);
-            }
-        }
-
+	if (Core.settings.getBool("showLogicMarkers", true)) {
+	        state.rules.objectives.eachRunning(obj -> {
+        	    for(var marker : obj.markers){
+                	if(marker.world){
+                   	 marker.draw(marker.autoscale ? scaleFactor : 1);
+                	}
+            	}
+        	});
+
+        	for(var marker : state.markers){
+        	    if(marker.world){
+        	        marker.draw(marker.autoscale ? scaleFactor : 1);
+        	    }
+       		 }
+	}
         Draw.reset();
 
         Draw.draw(Layer.overlayUI, overlays::drawTop);
diff --git a/core/src/mindustry/ui/dialogs/SettingsMenuDialog.java b/core/src/mindustry/ui/dialogs/SettingsMenuDialog.java
index 389ce62256..14c3018aba 100644
--- a/core/src/mindustry/ui/dialogs/SettingsMenuDialog.java
+++ b/core/src/mindustry/ui/dialogs/SettingsMenuDialog.java
@@ -528,6 +528,8 @@ public class SettingsMenuDialog extends BaseDialog{
         graphics.checkPref("indicators", true);
         graphics.checkPref("showweather", true);
         graphics.checkPref("animatedwater", true);
+	xxx:graphics.checkPref("showBossHealthBar", true);
+	yyy:graphics.checkPref("showLogicMarkers", true);
 
         if(Shaders.shield != null){
             graphics.checkPref("animatedshields", true);
diff --git a/core/src/mindustry/ui/fragments/HudFragment.java b/core/src/mindustry/ui/fragments/HudFragment.java
index de3757fb2d..a30dcabab0 100644
--- a/core/src/mindustry/ui/fragments/HudFragment.java
+++ b/core/src/mindustry/ui/fragments/HudFragment.java
@@ -648,7 +648,7 @@ public class HudFragment{
                 }
                 return max == 0f ? 0f : val / max;
             }).blink(Color.white).outline(new Color(0, 0, 0, 0.6f), 7f)).grow())
-            .fillX().width(320f).height(60f).name("boss").visible(() -> state.rules.waves && state.boss() != null && !(mobile && Core.graphics.isPortrait())).padTop(7).row();
+            .fillX().width(320f).height(60f).name("boss").visible(() -> state.rules.waves && state.boss() != null && !(mobile && Core.graphics.isPortrait()) && Core.settings.getBool("showBossHealthBar", true)).padTop(7).row();
 
             t.table(Styles.black3, p -> p.margin(4).label(() -> hudText).style(Styles.outlineLabel)).touchable(Touchable.disabled).with(p -> hudLabel = p)
                 .with(p -> p.visible(() -> (p.color.a = Mathf.lerpDelta(p.color.a, Mathf.num(showHudText), 0.2f)) >= 0.001f));
-- 
2.43.0

