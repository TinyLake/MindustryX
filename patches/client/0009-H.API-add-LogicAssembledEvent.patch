                     }
                 }
                 line ++;
diff --git a/core/src/mindustry/logic/LStatements.java b/core/src/mindustry/logic/LStatements.java
index 24a59a27c2bf2c6eac6945c5cd765c7ba76f3655..1f1f0b40418f89a5e75a897b8f0d69445f8616b7 100644
