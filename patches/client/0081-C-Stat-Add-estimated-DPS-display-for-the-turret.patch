@@ -1007,6 +1009,13 @@ public class StatValues{
                         bt.add(coll);
                     }
 
+                    Turret turret = blockName != null && !blockName.isEmpty() && Vars.content.block(blockName) instanceof Turret tur ? tur : null;
+                    if(turret != null){
+                        float dps = (type instanceof ContinuousBulletType || type instanceof PointLaserBulletType ? type.estimateDPS() : (type.estimateDPS() / turret.reload * type.reloadMultiplier)) * ShootPattern.shots(type.shootPattern != null ? type.shootPattern : turret.shoot) * 60f;
