From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WayZer <himc.wicp@gmail.com>
Date: Sun, 9 Aug 2026 23:33:27 +0800
Subject: [PATCH] FIX.G(DataPatcher) refresh icons of all content after data
 patches applied

including internal units created by blocks (e.g. BuildTurret), so they always have a fallback icon
---
 core/src/mindustry/mod/DataPatcher.java       | 20 +++++++++++++++++++
 .../world/blocks/storage/Unloader.java        |  5 +++++
 2 files changed, 25 insertions(+)

diff --git a/core/src/mindustry/mod/DataPatcher.java b/core/src/mindustry/mod/DataPatcher.java
index f4959335f0d566c1987267f5d54b0b7b6f3f54c7..98069c6ae4d967021511e32abf2009dbd54d2198 100644
--- a/core/src/mindustry/mod/DataPatcher.java
+++ b/core/src/mindustry/mod/DataPatcher.java
@@ -19,9 +19,11 @@ import mindustry.mod.data.*;
 import mindustry.type.*;
 import mindustry.world.*;
 import mindustry.world.blocks.*;
+import mindustry.world.blocks.storage.Unloader;
 import mindustry.world.consumers.*;
 import mindustry.world.draw.*;
 import mindustry.world.meta.*;
+import mindustry.world.modules.ItemModule;
 
 import java.lang.reflect.*;
 import java.util.*;
@@ -261,6 +263,18 @@ public class DataPatcher{
         }
 
         afterCallbacks.each(Runnable::run);
+
+        //MDTX: refresh icons of all content after applying data patches, including internal units created by blocks (e.g. BuildTurret), so they always have a fallback icon
+        if(!Vars.headless){
+            for(var arr : Vars.content.getContentMap()){
+                for(var c : arr){
+                    c.loadIcon();
+                }
+            }
+        }
+
+        //keep the cached unloader item list in sync with the new content
+        Unloader.cacheItems();
     }
 
     public void unapply(){
@@ -274,6 +288,9 @@ public class DataPatcher{
         Vars.content = contentLoader;
         applied = false;
 
+        //keep the cached unloader item list in sync with the rolled-back content
+        Unloader.cacheItems();
+
         resetters.reverse();
         for(var reset : resetters){
             try{
@@ -333,6 +350,9 @@ public class DataPatcher{
             }
         }
 
+        //the shared empty module is created at class load time, so it may be smaller than the current item count
+        ItemModule.empty.checkArrayCapacity(items);
+
         //TODO: this doesn't do anything about extensive ItemSeq usage across the codebase, which is limited to the campaign
         //TODO: this also doesn't change sectors
         needsArrayFix = false;
diff --git a/core/src/mindustry/world/blocks/storage/Unloader.java b/core/src/mindustry/world/blocks/storage/Unloader.java
index 9f73fbea69fac792208c035113c22ee9585630cd..bb215321008d43437d60f64ec12323b3ad0b4fb2 100644
--- a/core/src/mindustry/world/blocks/storage/Unloader.java
+++ b/core/src/mindustry/world/blocks/storage/Unloader.java
@@ -56,6 +56,11 @@ public class Unloader extends Block{
     public void init(){
         super.init();
 
+        cacheItems();
+    }
+
+    /** Refreshes the cached item list; must be called whenever content changes, e.g. when data patches are applied or unapplied. */
+    public static void cacheItems(){
         allItems = content.items().toArray(Item.class);
     }
 
