-                Core.bundle.get("bar.power"),
+                Iconc.power + " " + FormatDefault.percent(
+                entity.power.status * consPower.requestedPower(entity) * 60 * entity.timeScale(),
+                consPower.requestedPower(entity) * 60 * entity.timeScale(),
